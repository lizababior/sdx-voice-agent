# Copy to .env.local and fill in. Never commit .env.local.

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Use your own key. `npm run agent:setup` creates your own agent and prints its ID. Paste it here.
ELEVENLABS_AGENT_ID=

# Daytona: https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
